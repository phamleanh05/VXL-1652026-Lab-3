#include "fsm_automatic.h"

void fsm_mode(){
	switch(mode){
	case AUTO:
		trafficLightRun();
		display7SEG_Mode(MODE_1);
		break;
	case MANUAL:
	    HAL_GPIO_WritePin(GPIOA, EN0_Pin | EN1_Pin, SET);
	    HAL_GPIO_WritePin(GPIOB, EN2_Pin | EN3_Pin, SET);
		manualLight();
		display7SEG_Mode(MODE_2);
		break;
	case SET_RED:
		setTimeGreenLight();
		display7SEG_Mode(MODE_3);
		if(config_done_flag == 1){
			config_done_flag = 0;
			mode = MODE_1;
			init();
		}
		break;
	case SET_GREEN:
		break;
	default:
		mode = MODE_1;
		break;
	}
}
