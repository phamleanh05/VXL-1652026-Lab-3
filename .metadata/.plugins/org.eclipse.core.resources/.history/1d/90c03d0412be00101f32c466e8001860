#include "fsm_automatic.h"

void fsm_mode(){
	switch(mode){
	case MODE_1:
		trafficLightRun();
		display7SEG_Mode(MODE_1);
		break;
	case MODE_2:
		manualLight();
		display7SEG_Mode(MODE_2);
		break;
	case MODE_3:
		display7SEG_Mode(MODE_3);
		break;
	}
}
